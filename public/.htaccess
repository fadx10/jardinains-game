# ----------------------------------------------------------------------
# Jardinains! 1000 Level Arcade - .htaccess for /jardinains/
# Optimized for WordPress subfolder hosting on Apache / cPanel / LiteSpeed
# ----------------------------------------------------------------------

# 1. MIME Types (Essential for ES modules, audio, fonts, and assets in Apache)
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType application/wasm .wasm
  AddType application/json .json
  AddType audio/mpeg .mp3
  AddType audio/wav .wav
  AddType audio/ogg .ogg
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>

# 2. Prevent WordPress parent rewrite rules from interfering & route cleanly
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ensure trailing slash for directory requests so relative links load correctly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ $1/ [L,R=301]

  # If an existing file or directory is requested, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, route everything back to index.html in this directory
  RewriteRule ^ index.html [L]
</IfModule>

# 3. Default Document
DirectoryIndex index.html

# 4. Security & CORS Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Access-Control-Allow-Origin "*"
</IfModule>

# 5. Disable directory listing
Options -Indexes
