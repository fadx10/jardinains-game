# ----------------------------------------------------------------------
# Jardinains! 1000 Level Arcade - Universal Shared Web Hosting Configuration
# Compatible with cPanel, Hostinger, Apache 2.4+, LiteSpeed, and WordPress
# ----------------------------------------------------------------------

# 1. Prioritize index.php (the high-performance production streamer)
DirectoryIndex index.php dist/index.html index.html

# 2. MIME Types (Crucial for ES Modules, Audio, Fonts, and JSON)
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType application/wasm .wasm
  AddType application/json .json
  AddType application/manifest+json .json .webmanifest
  AddType audio/mpeg .mp3
  AddType audio/wav .wav
  AddType audio/ogg .ogg
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>

# 3. Rewrite Rules
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ensure trailing slash on directory requests
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ $1/ [L,R=301]

  # If requesting the root or index.html directly, route to index.php or dist/index.html
  RewriteRule ^$ index.php [L]
  RewriteRule ^index\.html$ index.php [L]

  # Serve existing static assets directly (svg, png, json, ico, css, js)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # If requesting files inside /dist/, allow direct access
  RewriteCond %{REQUEST_URI} ^.*/dist/.*$
  RewriteRule ^ - [L]

  # Catch-all: Route any other path to index.php
  RewriteRule . index.php [L]
</IfModule>

# 4. Security & CORS Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Access-Control-Allow-Origin "*"
  
  # Ensure HTML and PHP are never cached so updates apply immediately
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# 5. Disable directory browsing for security
Options -Indexes
