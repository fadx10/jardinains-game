# ----------------------------------------------------------------------
# Jardinains! 1000 Level Arcade - Hostinger Apache / Shared Hosting Config
# ----------------------------------------------------------------------

# 1. Set correct MIME Types for JavaScript Modules, CSS, and Game Assets
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType application/wasm .wasm
  AddType application/json .json
  AddType audio/mpeg .mp3
  AddType audio/wav .wav
  AddType audio/ogg .ogg
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>

# 2. Directory Index priority (dist/index.html if present, else root index.html)
DirectoryIndex dist/index.html index.html

# 3. Rewrite rules for Subdirectory hosting (/jardinains/)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /jardinains/

  # Ensure trailing slash for directory requests so relative links work properly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ /jardinains/$1/ [L,R=301]

  # Allow direct access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If dist/index.html exists on disk, route requests there
  RewriteCond %{DOCUMENT_ROOT}/jardinains/dist/index.html -f
  RewriteRule ^$ dist/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/jardinains/dist/index.html -f
  RewriteRule ^index\.html$ dist/index.html [L]

  # If dist/assets/ exists on disk, route assets requests there
  RewriteCond %{DOCUMENT_ROOT}/jardinains/dist/assets/$1 -f
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # SPA Fallback when dist/index.html exists
  RewriteCond %{DOCUMENT_ROOT}/jardinains/dist/index.html -f
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . dist/index.html [L]

  # Fallback to root index.html if dist/ is not yet deployed
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>

# 4. Security & Caching Headers
<IfModule mod_headers.c>
  # Enforce strict MIME checking safely
  Header set X-Content-Type-Options "nosniff"

  # Cache compiled JS and CSS assets safely
  <FilesMatch "\.(js|css|wasm|woff2|png|jpg|svg)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # Do not cache HTML to ensure instant updates
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
